{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "viewer",
  "description": "Окна просмотра чужого экрана: события и полноэкранный режим.",
  "windows": ["screen-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
